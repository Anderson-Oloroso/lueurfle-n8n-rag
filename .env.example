# Zona horaria del motor de automatización
GENERIC_TIMEZONE=America/Guatemala

# Subdominio gratuito de ngrok (sin https://)
NGROK_AUTHTOKEN=tu_token_de_ngrok
NGROK_DOMAIN=tu-subdominio.ngrok-free.app

# URL pública completa que usará n8n para generar enlaces de webhooks
N8N_WEBHOOK_URL=https://tu-subdominio.ngrok-free.app

# Referencia para configuración en n8n / Qdrant Web (3072 dims + Cosine)
QDRANT_URL=https://tu-cluster.qdrant.io
QDRANT_COLLECTION=lueurfle_french_3072
GEMINI_EMBEDDING_MODEL=gemini-embedding-001