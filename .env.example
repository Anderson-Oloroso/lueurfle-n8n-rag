# Zona horaria y red local de n8n
GENERIC_TIMEZONE=America/Guatemala
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
N8N_WEBHOOK_URL=http://localhost:5678/

# Túnel ngrok (opcional: activar con `docker compose --profile tunnel up -d`)
NGROK_AUTHTOKEN=tu_token_de_ngrok
NGROK_DOMAIN=tu-subdominio.ngrok-free.app

# Qdrant Cloud o local (`docker compose --profile local-qdrant up -d`)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PORT=6333
QDRANT_COLLECTION=lueurfle_french_3072
QDRANT_VECTOR_SIZE=3072
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
